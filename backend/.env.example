# Plantilla de variables de entorno para SYNAP.
# Copiá este archivo como ".env" (en la misma carpeta backend/) y completá los
# valores reales. El .env NUNCA se sube a GitHub (está en el .gitignore).

# Connection string de la base de Supabase (pedírsela a Ine por un canal privado).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Clave secreta para firmar los tokens de sesión.
# Generá una nueva con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pegar-aca-una-clave-larga-y-aleatoria

# SMTP para mandar mails de verdad (hoy: relay gratuito de Brevo, brevo.com).
# Si dejás estas 2 vacías o no cargás el .env, notificaciones.py cae solo al
# modo simulado (imprime el mail en la consola en vez de mandarlo).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=pegar-aca-tu-usuario-smtp-de-brevo
SMTP_PASSWORD=pegar-aca-tu-clave-smtp-de-brevo

# Dirección que aparece como remitente del mail. Tiene que ser una dirección
# VERIFICADA como remitente en tu cuenta de Brevo (pestaña "Remitentes,
# dominios e IP" → Remitentes) — si no está verificada, Brevo bloquea el
# envío sin avisar. Normalmente es la misma que EMAIL_NOTIFICACIONES.
SMTP_REMITENTE=pegar-aca-el-remitente-verificado-en-brevo

# Casilla FIJA que recibe las notificaciones automáticas del sistema (OT
# correctiva creada, stock crítico, MP por vencer) — no es el mail de un
# usuario puntual, es la casilla que revisa Bioingeniería.
EMAIL_NOTIFICACIONES=pegar-aca-el-gmail-de-bioingenieria